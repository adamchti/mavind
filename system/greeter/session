#!/bin/sh
# Mavind login screen: bring up a bare labwc with mavind-greeter as the only
# client. greetd runs this script fresh whenever a greeter is needed (boot,
# and again after every logout) — no retry loop required here.
set -eu

export XDG_RUNTIME_DIR=/run/mavind-greeter
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Mavind
export GDK_BACKEND=wayland
export WLR_NO_HARDWARE_CURSORS=1

# Always software rendering here, unconditionally — not just when no DRI
# device is present. Some VM GPU drivers (vmwgfx without "Accelerate 3D
# graphics" enabled, in particular) DO create a /dev/dri node and then just
# HANG forever on real GL init instead of failing cleanly, so a
# device-exists check can't tell hardware apart from hardware-shaped-but-
# broken. The login screen is simple and short-lived — there's nothing here
# worth risking a hang at every single boot for.
export WLR_RENDERER=pixman
export LIBGL_ALWAYS_SOFTWARE=1
export GSK_RENDERER=cairo

echo "mavind-greeter: starting" >&2
# labwc -s CMD: run CMD as startup client; labwc exits when it does (which
# also happens when greetd tears this session down after a successful login).
exec dbus-run-session -- labwc -s "mavind-greeter"
